# 百度网盘 xpan 开放平台凭证
# 注册地址：https://pan.baidu.com/union （创建应用后在「应用详情」里查看）
BAIDU_APP_KEY=你的AppKey
BAIDU_SECRET_KEY=你的SecretKey

# 网盘内的同步目录，默认 /apps/mynote（在网盘「我的应用数据」专区下，首次运行自动创建）。
# 一般不用改；想换目录时填 /apps/你想要的目录名（只能在 /apps 下）。
# BAIDU_DIR=/apps/mynote

# ---- 可选：分享全自动开关 ----
# 填了 BAIDU_BDUSS 后，脚本会用网盘网页端同款接口自动创建分享（不再需要手动粘贴）。
# 推荐获取方式（一次扫码自动写入，长期有效）：
#   npm run baidu:login
#   → 浏览器自动打开二维码 → 网盘 App 扫码并确认 → 脚本自动把下面两行写进 .env
#   以后无需重复扫码（改密码/退出登录才失效）。
# 手动方式（备选）：浏览器 F12 → 应用(Application) → Cookie → .baidu.com 节点 → 复制 BDUSS 值。
# ⚠️ BDUSS 等同于账号登录凭证：只能存在本机 .env（已被 gitignore），切勿外传/提交/截图。
#    该自动化走的是网页内部接口，非官方开放能力，低频自用一般没事，但接口随时可能变更。
# BAIDU_BDUSS=
# 可选：由 baidu:login 自动写入；手动填 BDUSS 报「登录状态失效」时才需要
# BAIDU_STOKEN=
# 分享有效期（天）：0=永久。部分非会员账号不支持永久分享，报错就改成 30
# BAIDU_SHARE_PERIOD=0

# 每次同步自动补分享的数量上限（防止触发百度单日分享次数上限 errno=130）
BAIDU_MAX_SHARES_PER_RUN=10
