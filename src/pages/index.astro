---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NoteCard from "../components/NoteCard.astro";
import { getCollection, render } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { encryptForBrowser } from "../utils/encrypt";
import { getSortedPosts } from "../utils/posts";
import { SITE } from "../config";
import fs from "node:fs";
import path from "node:path";

const posts = (await getSortedPosts()).slice(0, 6);

// 随手记：取最新 4 条（排除草稿和隐藏），有密码的加密
const notes = (await getCollection("notes", ({ data }) => !data.draft && !data.hidden))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const container = await AstroContainer.create();
const preparedNotes = await Promise.all(
  notes.map(async (n) => {
    const { Content } = await render(n);
    const html = await container.renderToString(Content);
    return {
      n,
      html,
      payload: n.data.password ? encryptForBrowser(html, n.data.password) : undefined,
    };
  })
);

const base = import.meta.env.BASE_URL;

// 资料：读取 src/files/*.md（排除隐藏），取最新 4 条用于主页缩略图展示
const IMG_EXT = ["png", "jpg", "jpeg", "gif", "webp", "svg", "avif", "bmp", "ico"];
const normUrl = (u: string) => u.replace(/^["']|["']$/g, "").replace(/^\/?public\//, "/");
const files = fs
  .readdirSync(path.resolve("src/files"))
  .filter((f) => f.endsWith(".md"))
  .map((f) => {
    const fm = (fs.readFileSync(path.resolve("src/files", f), "utf8").match(/^---\r?\n([\s\S]*?)\r?\n---/) ?? [])[1] ?? "";
    const val = (k: string) => fm.match(new RegExp("^" + k + ":\\s*(.*)$", "m"))?.[1]?.trim() ?? "";
    const atts = [
      ...[...fm.matchAll(/(?:^|\n)\s*-\s*file:\s*([^\n]+)/g)].map((m) => normUrl(m[1])),
      ...(val("attachment") ? [normUrl(val("attachment"))] : []),
    ];
    return {
      title: val("title") || f.replace(/\.md$/, ""),
      date: val("date"),
      hidden: /^true$/i.test(val("hidden")),
      atts: [...new Set(atts)],
    };
  })
  .filter((x) => !x.hidden)
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <h1>你好，我是 {SITE.author}</h1>
    <p class="sub">{SITE.description}</p>
    <div class="btns">
      <a class="btn primary" href={`${base}posts/`}>开始阅读</a>
      <a class="btn" href={`${base}admin/#/collections/notes/new`} target="_blank">去写随手记</a>
    </div>
  </section>

  <div class="section-head">
    <h2>最新文章</h2>
    <a class="more" href={`${base}posts/`}>全部文章 →</a>
  </div>
  <div class="grid">
    {posts.map((p) => <PostCard post={p} />)}
  </div>

  {
    preparedNotes.length > 0 && (
      <>
        <div class="section-head">
          <h2>随手记</h2>
          <span class="more-links">
            <a class="more" href={`${base}admin/#/collections/notes/new`} target="_blank">
              写随手记
            </a>
            <a class="more" href={`${base}notes/`}>全部随手记 →</a>
          </span>
        </div>
        <div class="timeline">
          {preparedNotes.map(({ n, html, payload }) => (
            <NoteCard note={n} html={html} payload={payload} />
          ))}
        </div>
      </>
    )
  }

  {
    files.length > 0 && (
      <>
        <div class="section-head">
          <h2>资料</h2>
          <a class="more" href={`${base}files/`}>全部资料 →</a>
        </div>
        <div class="grid">
          {files.map((f) => {
            const img = f.atts.find((u) => IMG_EXT.includes((u.split("?")[0].split(".").pop() ?? "").toLowerCase()));
            const firstExt = (f.atts[0]?.split("?")[0].split(".").pop() ?? "file").toUpperCase();
            return (
              <a class="card file-card" href={`${base}files/`}>
                {img ? (
                  <img class="file-thumb" src={img} alt={f.title} loading="lazy" />
                ) : (
                  <span class="file-thumb-placeholder">{firstExt}</span>
                )}
                <div class="file-card-body">
                  <h3>{f.title}</h3>
                  <p>
                    {f.atts.length} 个文件{f.date ? ` · ${f.date}` : ""}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )
  }
</BaseLayout>
