---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 资料：日期倒序（排除隐藏）
const files = (await getCollection("files", ({ data }) => !data.hidden)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 预览能力分类：图片 / PDF / 文本（含 Markdown 渲染）/ 其他（仅下载）
const fmtDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
const urlOf = (att: string) => att.startsWith("http") ? att : base + (att.startsWith("/") ? att : "/" + att);
const extOf = (u: string) => (u.split("?")[0].split(".").pop() || "").toLowerCase();
const IMG = ["png", "jpg", "jpeg", "gif", "webp", "svg", "avif", "bmp", "ico"];
const TEXT = ["md", "markdown", "txt", "log", "json", "csv", "yml", "yaml", "xml", "html", "css", "js", "ts", "py", "c", "h", "cpp", "java", "asm", "s", "ini", "toml", "bat", "sh"];
const kindOf = (u: string) => {
  const e = extOf(u);
  if (IMG.includes(e)) return "image";
  if (e === "pdf") return "pdf";
  if (TEXT.includes(e)) return "text";
  return "file";
};
// 每条资料的文件列表：兼容旧版单文件 attachment + 新版多文件 attachments
const fileList = (f: (typeof files)[number]) => {
  const list: string[] = [];
  if (f.data.attachment) list.push(urlOf(f.data.attachment));
  for (const a of f.data.attachments ?? []) {
    if (a.file && !list.includes(urlOf(a.file))) list.push(urlOf(a.file));
  }
  return list;
};
const nameOf = (u: string) => decodeURIComponent(u.split("/").pop() || u);
---

<BaseLayout title="资料" description="上传的笔记与资料库，支持在线预览与下载。">
  <div class="page-head with-actions">
    <div>
      <h1>资料</h1>
      <p>共 {files.length} 份 · 图片 / PDF / Markdown 直接在页面内显示，其他类型提供下载</p>
    </div>
    <a class="btn primary" href={`${base}/admin/#/collections/files/new`} target="_blank">上传资料</a>
  </div>

  {
    files.length === 0 && (
      <p class="search-hint">
        还没有资料。点右上角「上传资料」，或在后台「资料上传」中添加。
      </p>
    )
  }

  <div class="file-list">
    {
      files.map((f) => {
        const urls = fileList(f);
        return (
          <div class="card file-card">
            <div class="file-head">
              <h3>{f.data.title}</h3>
              <p class="desc">
                {fmtDate(f.data.date)}
                {f.data.description ? " · " + f.data.description : ""}
              </p>
            </div>
            {urls.map((u) => {
              const kind = kindOf(u);
              return (
                <div class="file-item">
                  <div class="file-row">
                    <span class="file-badge">{(extOf(u) || "file").toUpperCase()}</span>
                    <span class="file-name" title={nameOf(u)}>
                      {nameOf(u)}
                    </span>
                    <div class="file-actions">
                      <a class="btn" href={u} target="_blank" rel="noopener" download>
                        下载
                      </a>
                    </div>
                  </div>
                  {kind !== "file" && <div class="file-inline" data-url={u} data-kind={kind} />}
                </div>
              );
            })}
          </div>
        );
      })
    }
  </div>

  <!-- 预览弹窗 -->
  <div class="file-modal" id="file-modal" hidden>
    <div class="file-modal-mask"></div>
    <div class="file-modal-panel">
      <div class="file-modal-head">
        <span id="file-modal-title"></span>
        <div class="file-modal-head-actions">
          <a id="file-modal-open" href="#" target="_blank" rel="noopener">新窗口打开</a>
          <button type="button" id="file-modal-close" aria-label="关闭">×</button>
        </div>
      </div>
      <div class="file-modal-body" id="file-modal-body"></div>
    </div>
  </div>

  <script>
    // 懒加载 marked（Markdown 渲染），失败时退回纯文本显示
    let markedReady: Promise<void> | null = null;
    function ensureMarked() {
      if (!markedReady) {
        markedReady = new Promise<void>((resolve) => {
          const s = document.createElement("script");
          s.src = "https://cdn.jsdelivr.net/npm/marked/marked.min.js";
          s.onload = () => resolve();
          s.onerror = () => resolve();
          document.head.appendChild(s);
        });
      }
      return markedReady;
    }

    const modal = document.getElementById("file-modal")!;
    const body = document.getElementById("file-modal-body")!;
    const titleEl = document.getElementById("file-modal-title")!;
    const openEl = document.getElementById("file-modal-open") as HTMLAnchorElement;
    let lastFocus: HTMLElement | null = null;

    function openModal(title: string, url: string) {
      lastFocus = document.activeElement as HTMLElement;
      titleEl.textContent = title;
      openEl.href = url;
      modal.hidden = false;
      body.classList.remove("has-image");
      document.documentElement.style.overflow = "hidden";
      (document.getElementById("file-modal-close") as HTMLButtonElement).focus();
    }
    function closeModal() {
      modal.hidden = true;
      body.innerHTML = "";
      document.documentElement.style.overflow = "";
      lastFocus?.focus();
    }

    // 把一个文件的内嵌预览填充到指定容器（列表内嵌与放大弹窗共用）
    async function fillPreview(kind: string, url: string, box: HTMLElement) {
      const ext = (url.split("?")[0].split(".").pop() || "").toLowerCase();
      if (kind === "image") {
        const img = document.createElement("img");
        img.src = url;
        img.alt = "";
        img.loading = "lazy";
        img.title = "点击放大";
        img.addEventListener("click", () => {
          openModal("查看图片", url);
          body.innerHTML = "";
          body.classList.add("has-image");
          const big = document.createElement("img");
          big.src = url;
          big.alt = "";
          body.appendChild(big);
        });
        box.appendChild(img);
        return;
      }
      if (kind === "pdf") {
        const iframe = document.createElement("iframe");
        iframe.src = url;
        iframe.loading = "lazy";
        box.appendChild(iframe);
        return;
      }
      // 文本类：md 走 marked 渲染，其余放进 pre
      const pre = document.createElement("div");
      pre.className = "file-text" + (ext === "md" || ext === "markdown" ? " rendered-md" : " raw-pre");
      box.appendChild(pre);
      pre.textContent = "加载中…";
      let text = "";
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(String(res.status));
        text = await res.text();
      } catch {
        pre.textContent = "加载失败，请用「下载」查看原文件。";
        return;
      }
      if (ext === "md" || ext === "markdown") {
        await ensureMarked();
        if ((window as any).marked) {
          pre.innerHTML = (window as any).marked.parse(text);
        } else {
          pre.classList.remove("rendered-md");
          pre.classList.add("raw-pre");
          pre.textContent = text;
        }
      } else {
        pre.textContent = text;
      }
    }

    // 页面加载后自动内嵌预览所有可直接显示的文件
    document.querySelectorAll<HTMLElement>(".file-inline").forEach((box) => {
      fillPreview(box.dataset.kind!, box.dataset.url!, box);
    });

    document.getElementById("file-modal-close")!.addEventListener("click", closeModal);
    document.querySelector(".file-modal-mask")!.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) closeModal();
    });
  </script>
</BaseLayout>

<style is:global>
  /* 注意：预览内容（img/iframe/file-text）由前端 JS 动态创建，
     不带 Astro 的 scoped 属性，因此本块样式必须全局生效才能匹配 */
  .file-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .file-card {
    padding: 14px 18px;
  }
  .file-head h3 {
    margin: 0;
    font-size: 15.5px;
  }
  .file-head .desc {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .file-item {
    padding: 8px 0 0;
    margin-top: 8px;
    border-top: 1px dashed var(--border);
  }
  .file-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* 内嵌预览：图片 / PDF / 文本直接显示 */
  .file-inline {
    margin-top: 10px;
  }
  .file-inline img {
    display: inline-block;
    height: 52px;
    max-width: 90px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    cursor: zoom-in;
    margin: 0 8px 8px 0;
    vertical-align: middle;
  }
  .file-inline iframe {
    display: block;
    width: 100%;
    height: 520px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
  }
  .file-inline .file-text {
    max-height: 460px;
    overflow: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px 20px;
  }
  .file-badge {
    flex: none;
    min-width: 52px;
    text-align: center;
    padding: 5px 8px;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .file-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
  }
  .file-actions {
    flex: none;
    display: flex;
    gap: 8px;
  }
  .file-actions .btn {
    padding: 5px 14px;
    font-size: 13px;
    cursor: pointer;
  }

  /* 预览弹窗 */
  .file-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .file-modal[hidden] {
    display: none;
  }
  .file-modal-mask {
    position: absolute;
    inset: 0;
    background: rgba(10, 14, 25, 0.55);
  }
  .file-modal-panel {
    position: relative;
    width: min(960px, 100%);
    height: min(82vh, 820px);
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .file-modal-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 14px;
  }
  .file-modal-head-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .file-modal-head-actions a {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-strong);
  }
  #file-modal-close {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
  }
  #file-modal-close:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  .file-modal-body {
    flex: 1;
    overflow: auto;
    background: var(--bg);
  }
  /* 图片模式：图片自适应弹窗大小，不溢出（不依赖 JS 类名，纯 CSS 兜底） */
  .file-modal-body > img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
  }
  .file-modal-body.has-image {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }
  .file-modal-body.has-image img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0;
    border-radius: 6px;
  }
  .file-modal-body iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .file-text {
    max-width: 820px;
    margin: 0 auto;
    padding: 20px 24px 32px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text);
  }
  .file-text.raw-pre {
    font-family: ui-monospace, Consolas, "Courier New", monospace;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .file-text.rendered-md h1,
  .file-text.rendered-md h2,
  .file-text.rendered-md h3 {
    margin: 1.2em 0 0.5em;
    line-height: 1.35;
  }
  .file-text.rendered-md p {
    margin: 0.6em 0;
  }
  .file-text.rendered-md pre {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    overflow: auto;
    font-size: 13px;
  }
  .file-text.rendered-md code {
    background: var(--bg-soft);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 13px;
  }
  .file-text.rendered-md pre code {
    background: transparent;
    padding: 0;
  }
  .file-text.rendered-md blockquote {
    margin: 0.8em 0;
    padding: 2px 0 2px 12px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
  .file-text.rendered-md table {
    border-collapse: collapse;
    margin: 0.8em 0;
  }
  .file-text.rendered-md th,
  .file-text.rendered-md td {
    border: 1px solid var(--border);
    padding: 6px 10px;
    font-size: 13.5px;
  }
  .file-text.rendered-md img {
    max-width: 100%;
  }
</style>
