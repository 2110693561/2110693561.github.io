---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 资料：日期倒序（排除隐藏）
const files = (await getCollection("files", ({ data }) => !data.hidden)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 预览能力分类：图片 / PDF / 文本（含 Markdown 渲染）/ 其他（仅下载）
const fmtDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
const urlOf = (att: string) => att.startsWith("http") ? att : base + (att.startsWith("/") ? att : "/" + att);
const extOf = (u: string) => (u.split("?")[0].split(".").pop() || "").toLowerCase();
const IMG = ["png", "jpg", "jpeg", "gif", "webp", "svg", "avif", "bmp", "ico"];
const TEXT = ["md", "markdown", "txt", "log", "json", "csv", "yml", "yaml", "xml", "html", "css", "js", "ts", "py", "c", "h", "cpp", "java", "asm", "s", "ini", "toml", "bat", "sh"];
const kindOf = (u: string) => {
  const e = extOf(u);
  if (IMG.includes(e)) return "image";
  if (e === "pdf") return "pdf";
  if (TEXT.includes(e)) return "text";
  return "file";
};
---

<BaseLayout title="资料" description="上传的笔记与资料库，支持在线预览与下载。">
  <div class="page-head with-actions">
    <div>
      <h1>资料</h1>
      <p>共 {files.length} 份 · 图片 / PDF / 文本可直接预览，其他类型提供下载</p>
    </div>
    <a class="btn primary" href={`${base}/admin/#/collections/files/new`} target="_blank">上传资料</a>
  </div>

  {
    files.length === 0 && (
      <p class="search-hint">
        还没有资料。点右上角「上传资料」，或在后台「资料上传」中添加。
      </p>
    )
  }

  <div class="file-list">
    {
      files.map((f) => {
        const url = urlOf(f.data.attachment);
        const kind = kindOf(url);
        const ext = extOf(url).toUpperCase() || "FILE";
        return (
          <div class="card file-card" data-url={url} data-kind={kind} data-title={f.data.title}>
            <div class="file-badge">{ext}</div>
            <div class="file-info">
              <h3>{f.data.title}</h3>
              <p class="desc">
                {fmtDate(f.data.date)}
                {f.data.description ? " · " + f.data.description : ""}
              </p>
            </div>
            <div class="file-actions">
              {kind !== "file" && (
                <button type="button" class="btn file-preview-btn" data-url={url} data-kind={kind}>
                  预览
                </button>
              )}
              <a class="btn" href={url} target="_blank" rel="noopener" download>
                下载
              </a>
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- 预览弹窗 -->
  <div class="file-modal" id="file-modal" hidden>
    <div class="file-modal-mask"></div>
    <div class="file-modal-panel">
      <div class="file-modal-head">
        <span id="file-modal-title"></span>
        <div class="file-modal-head-actions">
          <a id="file-modal-open" href="#" target="_blank" rel="noopener">新窗口打开</a>
          <button type="button" id="file-modal-close" aria-label="关闭">×</button>
        </div>
      </div>
      <div class="file-modal-body" id="file-modal-body"></div>
    </div>
  </div>

  <script>
    // 懒加载 marked（Markdown 渲染），失败时退回纯文本显示
    let markedReady: Promise<void> | null = null;
    function ensureMarked() {
      if (!markedReady) {
        markedReady = new Promise<void>((resolve) => {
          const s = document.createElement("script");
          s.src = "https://cdn.jsdelivr.net/npm/marked/marked.min.js";
          s.onload = () => resolve();
          s.onerror = () => resolve();
          document.head.appendChild(s);
        });
      }
      return markedReady;
    }

    const modal = document.getElementById("file-modal")!;
    const body = document.getElementById("file-modal-body")!;
    const titleEl = document.getElementById("file-modal-title")!;
    const openEl = document.getElementById("file-modal-open") as HTMLAnchorElement;
    let lastFocus: HTMLElement | null = null;

    function openModal(title: string, url: string) {
      lastFocus = document.activeElement as HTMLElement;
      titleEl.textContent = title;
      openEl.href = url;
      modal.hidden = false;
      document.documentElement.style.overflow = "hidden";
      (document.getElementById("file-modal-close") as HTMLButtonElement).focus();
    }
    function closeModal() {
      modal.hidden = true;
      body.innerHTML = "";
      document.documentElement.style.overflow = "";
      lastFocus?.focus();
    }

    async function renderInto(kind: string, url: string) {
      const ext = (url.split("?")[0].split(".").pop() || "").toLowerCase();
      if (kind === "image") {
        const img = document.createElement("img");
        img.src = url;
        img.alt = "";
        body.appendChild(img);
        return;
      }
      if (kind === "pdf") {
        const iframe = document.createElement("iframe");
        iframe.src = url;
        body.appendChild(iframe);
        return;
      }
      // 文本类：md 走 marked 渲染，其余放进 pre
      const pre = document.createElement("div");
      pre.className = "file-text" + (ext === "md" || ext === "markdown" ? " rendered-md" : " raw-pre");
      body.appendChild(pre);
      pre.textContent = "加载中…";
      let text = "";
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(String(res.status));
        text = await res.text();
      } catch {
        pre.textContent = "加载失败，请用「新窗口打开」查看原文件。";
        return;
      }
      if (ext === "md" || ext === "markdown") {
        await ensureMarked();
        if ((window as any).marked) {
          pre.innerHTML = (window as any).marked.parse(text);
        } else {
          pre.classList.remove("rendered-md");
          pre.classList.add("raw-pre");
          pre.textContent = text;
        }
      } else {
        pre.textContent = text;
      }
    }

    document.querySelectorAll<HTMLButtonElement>(".file-preview-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const card = btn.closest(".file-card") as HTMLElement;
        const title = card?.dataset.title || "预览";
        const url = btn.dataset.url!;
        openModal(title, url);
        body.innerHTML = "";
        renderInto(btn.dataset.kind!, url);
      });
    });

    document.getElementById("file-modal-close")!.addEventListener("click", closeModal);
    document.querySelector(".file-modal-mask")!.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) closeModal();
    });
  </script>
</BaseLayout>

<style>
  .file-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .file-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
  }
  .file-badge {
    flex: none;
    min-width: 52px;
    text-align: center;
    padding: 6px 8px;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .file-info {
    flex: 1;
    min-width: 0;
  }
  .file-info h3 {
    margin: 0;
    font-size: 15.5px;
  }
  .file-info .desc {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .file-actions {
    flex: none;
    display: flex;
    gap: 8px;
  }
  .file-actions .btn {
    padding: 5px 14px;
    font-size: 13px;
    cursor: pointer;
  }

  /* 预览弹窗 */
  .file-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .file-modal[hidden] {
    display: none;
  }
  .file-modal-mask {
    position: absolute;
    inset: 0;
    background: rgba(10, 14, 25, 0.55);
  }
  .file-modal-panel {
    position: relative;
    width: min(960px, 100%);
    height: min(82vh, 820px);
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .file-modal-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 14px;
  }
  .file-modal-head-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .file-modal-head-actions a {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-strong);
  }
  #file-modal-close {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
  }
  #file-modal-close:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  .file-modal-body {
    flex: 1;
    overflow: auto;
    background: var(--bg);
  }
  .file-modal-body img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    margin: 0 auto;
    object-fit: contain;
  }
  .file-modal-body iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .file-text {
    max-width: 820px;
    margin: 0 auto;
    padding: 20px 24px 32px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text);
  }
  .file-text.raw-pre {
    font-family: ui-monospace, Consolas, "Courier New", monospace;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .file-text.rendered-md h1,
  .file-text.rendered-md h2,
  .file-text.rendered-md h3 {
    margin: 1.2em 0 0.5em;
    line-height: 1.35;
  }
  .file-text.rendered-md p {
    margin: 0.6em 0;
  }
  .file-text.rendered-md pre {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    overflow: auto;
    font-size: 13px;
  }
  .file-text.rendered-md code {
    background: var(--bg-soft);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 13px;
  }
  .file-text.rendered-md pre code {
    background: transparent;
    padding: 0;
  }
  .file-text.rendered-md blockquote {
    margin: 0.8em 0;
    padding: 2px 0 2px 12px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
  .file-text.rendered-md table {
    border-collapse: collapse;
    margin: 0.8em 0;
  }
  .file-text.rendered-md th,
  .file-text.rendered-md td {
    border: 1px solid var(--border);
    padding: 6px 10px;
    font-size: 13.5px;
  }
  .file-text.rendered-md img {
    max-width: 100%;
  }
</style>
