---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LockedContent from "../../components/LockedContent.astro";
import Giscus from "../../components/Giscus.astro";
import { getCollection, render } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { encryptForBrowser, type EncryptedPayload } from "../../utils/encrypt";
import { loadAnnotations } from "../../utils/annotations";
import { marked } from "marked";
import { replaceTokens } from "../../utils/netdisk-card.mjs";
import netdiskManifest from "../../data/netdisk.json";
import {
  getSortedPosts,
  formatDate,
  readingMinutes,
  postUrl,
  tagUrl,
  categoryUrl,
} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 密码保护：构建时加密渲染后的 HTML，浏览器输入密码解锁
let encrypted: EncryptedPayload | undefined;
if (post.data.password) {
  const container = await AstroContainer.create();
  const html = await container.renderToString(Content);
  encrypted = encryptForBrowser(html, post.data.password);
}

// 段落批注（存放在 src/data/annotations/*.json）
const annotations = (loadAnnotations().get(post.id) ?? [])
  .slice()
  .sort((a, b) => a.index - b.index)
  // 构建期预渲染批注内容：markdown → HTML，并把 {{netdisk 文件名}} 替换为下载卡片
  .map((anno) => ({
    ...anno,
    contentHtml: marked.parse(replaceTokens(anno.content, netdiskManifest), { breaks: true, mangle: false, headerIds: false }) as string,
  }));
const annotationJson = JSON.stringify(annotations).replace(/</g, "\\u003c");
// 内联网盘清单子集（供前台新建批注即时显示卡片用，只含被本篇批注引用的文件）
const annoFiles = new Set<string>();
for (const a of annotations) {
  for (const m of a.content.matchAll(/\{\{(?:netdisk|网盘)\s+([^{}]+?)\s*\}\}/g)) {
    annoFiles.add(m[1]);
  }
}
const annoNetdiskCards = (netdiskManifest.files || []).filter((f) => annoFiles.has(f.basename));
const annoNetdiskJson = JSON.stringify(annoNetdiskCards).replace(/</g, "\\u003c");

// 上下篇导航（列表按日期倒序）
const allPosts = await getSortedPosts();
const idx = allPosts.findIndex((p) => p.id === post.id);
const older = allPosts[idx + 1];
const newer = allPosts[idx - 1];

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const minutes = readingMinutes(post.body);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={post.data.title} description={post.data.description || undefined}>
  <header class="post-header">
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      <span>{formatDate(post.data.date)}</span>
      <a href={categoryUrl(post.data.category)}>{post.data.category}</a>
      <span>约 {minutes} 分钟</span>
      {post.data.password && <span class="lock-badge">已加密</span>}
      <a class="edit-btn" href={`${base}admin/#/collections/blog/entries/${post.id}`} target="_blank">编辑</a>
    </div>
    {
      post.data.tags.length > 0 && (
        <div class="tags" style="margin-top: 8px;">
          {post.data.tags.map((t) => (
            <a class="tag" href={tagUrl(t)}>
              {t}
            </a>
          ))}
        </div>
      )
    }
  </header>

  <div class="post-layout">
    {
      encrypted ? (
        <article class="prose">
          <LockedContent payload={encrypted} />
        </article>
      ) : (
        <article class="prose" id="post-body" data-post={post.id}>
          <Content />
        </article>
      )
    }

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="文章目录">
          <div class="toc-title">目录</div>
          {toc.map((h) => (
            <a class={`lv${h.depth}`} href={`#${h.slug}`}>
              {h.text}
            </a>
          ))}
        </aside>
      )
    }
  </div>

  {!encrypted && (
    <script type="application/json" id="annotation-data" set:html={annotationJson} />
  )}
  {!encrypted && annoNetdiskCards.length > 0 && (
    <script type="application/json" id="netdisk-cards-data" set:html={annoNetdiskJson} />
  )}

  <nav class="post-nav" aria-label="上下篇">
    {
      older ? (
        <a href={postUrl(older.id)}>
          <div class="pn-label">← 更早</div>
          <div class="pn-title">{older.data.title}</div>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class="next" href={postUrl(newer.id)}>
          <div class="pn-label">更新 →</div>
          <div class="pn-title">{newer.data.title}</div>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  {!encrypted && <Giscus />}
</BaseLayout>

<script>
  // ============ 段落批注 UI ============
  // 站长（后台已登录）可直接在页面上保存/删除批注：通过 GitHub API 写入仓库，
  // 保存后本页立即显示，同时自动 commit 触发构建同步给所有访客（约 1-2 分钟）。
  import { SITE } from "../../config";

  const REPO = SITE.repo;
  const BRANCH = "main";
  const GH = "https://api.github.com";

  type Anno = { post: string; index: number; quote?: string; content: string; date: string; file?: string; contentHtml?: string };

  /** 读取 Decap CMS 登录后留在浏览器里的令牌（站长身份） */
  const getUserToken = (): string | null => {
    for (const key of ["decap-cms-user", "netlify-cms-user"]) {
      try {
        const raw = localStorage.getItem(key);
        if (!raw) continue;
        const user = JSON.parse(raw) as { token?: unknown };
        if (user && typeof user.token === "string" && user.token) return user.token;
      } catch {
        /* ignore */
      }
    }
    return null;
  };

  const ghHeaders = (token: string) => ({
    Authorization: `Bearer ${token}`,
    Accept: "application/vnd.github+json",
  });

  /** UTF-8 安全的 base64 */
  const b64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));

  /** 客户端渲染批注内容（新建批注即时显示，构建期已有 contentHtml 的不走这里） */
  const TOKEN_RE_C = /\{\{(?:netdisk|网盘)\s+([^{}]+?)\s*\}\}/g;
  const escHtml = (s: string) =>
    String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  function buildCardClient(name: string): string {
    const cardsEl = document.getElementById("netdisk-cards-data");
    let cards: { basename: string; size: number; link: string | null; code: string | null }[] = [];
    if (cardsEl) {
      try { cards = JSON.parse(cardsEl.textContent || "[]"); } catch { /* ignore */ }
    }
    const f = cards.find((x) => x.basename === name);
    if (!f) {
      return `<span class="nd-card nd-missing"><span class="nd-ico">⚠️</span><span class="nd-info"><span class="nd-name">${escHtml(name)}</span><span class="nd-meta">网盘中未找到该文件</span></span><a class="nd-btn" href="/disk/">查看网盘</a></span>`;
    }
    const sizeStr = f.size ? (f.size < 1048576 ? `${(f.size / 1024).toFixed(1)} KB` : `${(f.size / 1048576).toFixed(1)} MB`) : "";
    const code = f.code ? escHtml(f.code) : "";
    const meta = [sizeStr, code ? `提取码 ${code}` : null].filter(Boolean).join(" · ");
    const link = f.link
      ? `<a class="nd-btn baidu-btn" href="${escHtml(f.link)}" target="_blank" rel="noopener">下载</a>`
      : `<a class="nd-btn nd-disabled" href="/disk/" title="分享链接尚未创建">待分享</a>`;
    const copy = code ? `<button class="nd-copy code-btn" type="button" data-code="${code}" title="点击复制提取码">提取码</button>` : "";
    return `<span class="nd-card"><span class="nd-ico">📦</span><span class="nd-info"><span class="nd-name">${escHtml(f.basename)}</span><span class="nd-meta">${escHtml(meta)}</span></span>${link}${copy}</span>`;
  }
  let markedReady: Promise<void> | null = null;
  function ensureMarked(): Promise<void> {
    if (markedReady) return markedReady;
    markedReady = new Promise<void>((resolve) => {
      const s = document.createElement("script");
      s.src = "https://cdn.jsdelivr.net/npm/marked/marked.min.js";
      s.onload = () => resolve();
      s.onerror = () => resolve();
      document.head.appendChild(s);
    });
    return markedReady;
  }
  function renderAnnoContentClient(raw: string): string {
    if (!raw) return "";
    // 无 token 或无 marked 时退回 HTML 转义纯文本
    if (!TOKEN_RE_C.test(raw) && !/[`#*\-\[>]/.test(raw)) {
      return escHtml(raw).replace(/\n/g, "<br>");
    }
    // 先替换 token 为卡片 HTML span（marked 会原样保留内联 HTML）
    const withCards = raw.replace(TOKEN_RE_C, (_m, name) => buildCardClient(name));
    // 有 marked 时走 markdown 渲染；否则退回转义 + 卡片
    if ((window as any).marked) {
      try {
        return (window as any).marked.parse(withCards, { breaks: true, mangle: false, headerIds: false });
      } catch { /* fallthrough */ }
    }
    // marked 还没加载：先转义纯文本（卡片 span 是原始 HTML 会被保留），异步加载 marked 后下次再渲染
    void ensureMarked();
    return withCards.split("\n").map((l) => escHtml(l).replace(/<span /g, "<span ")).join("<br>");
  }

  const body = document.getElementById("post-body");
  if (body) {
    const base = import.meta.env.BASE_URL;
    const dataEl = document.getElementById("annotation-data");
    const annotations: Anno[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const blocks = Array.from(body.children) as HTMLElement[];

    // 先给原始段落标记序号（在插入批注卡片前，避免卡片导致索引偏移）
    blocks.forEach((block, i) => (block.dataset.annoIndex = String(i)));

    const findBlock = (anno: { index: number; quote?: string }) => {
      if (anno.quote) {
        const hit = blocks.find((b) => (b.textContent || "").includes(anno.quote!));
        if (hit) return hit;
      }
      return blocks[anno.index] ?? null;
    };

    const renderAnnotation = (anno: Anno) => {
      const anchor = findBlock(anno);
      if (!anchor) return null;
      const card = document.createElement("aside");
      card.className = "annotation-card";
      const quote = document.createElement("div");
      quote.className = "anno-quote";
      quote.textContent = anno.quote ? `「${anno.quote.slice(0, 60)}」` : "";
      const content = document.createElement("div");
      content.className = "anno-content";
      // 构建期已预渲染的用 innerHTML；新建批注即时显示时走客户端渲染降级
      if (anno.contentHtml) {
        content.innerHTML = anno.contentHtml;
      } else {
        content.innerHTML = renderAnnoContentClient(anno.content);
      }
      const date = document.createElement("div");
      date.className = "anno-date";
      date.textContent = anno.date || "";
      card.append(quote, content, date);
      anchor.insertAdjacentElement("afterend", card);
      return card;
    };

    /** 给批注卡片加删除按钮（通过 GitHub API 删除仓库里的 JSON 文件） */
    const attachDelete = (card: HTMLElement, file: string) => {
      const del = document.createElement("button");
      del.type = "button";
      del.className = "anno-delete";
      del.title = "删除这条批注";
      del.textContent = "×";
      del.addEventListener("click", async () => {
        if (!confirm("确定删除这条批注？删除后自动构建生效。")) return;
        del.disabled = true;
        try {
          const token = getUserToken()!;
          const path = `src/data/annotations/${file}`;
          const meta = await fetch(`${GH}/repos/${REPO}/contents/${path}?ref=${BRANCH}`, {
            headers: ghHeaders(token),
          });
          if (meta.status !== 404) {
            if (!meta.ok) throw new Error(`GitHub API ${meta.status}`);
            const { sha } = (await meta.json()) as { sha: string };
            const res = await fetch(`${GH}/repos/${REPO}/contents/${path}`, {
              method: "DELETE",
              headers: ghHeaders(token),
              body: JSON.stringify({ message: `删除批注 ${file}`, sha, branch: BRANCH }),
            });
            if (!res.ok) throw new Error(`GitHub API ${res.status}`);
          }
          card.remove();
        } catch (err) {
          del.disabled = false;
          alert(err instanceof Error && err.message.includes("401") ? "登录已过期，请到后台重新登录后再试。" : `删除失败：${err instanceof Error ? err.message : err}`);
        }
      });
      card.appendChild(del);
    };

    // 渲染已有批注（站长登录时可删除）
    const canWrite = !!getUserToken();
    for (const anno of annotations) {
      const card = renderAnnotation(anno);
      if (!card || !canWrite || !anno.file) continue;
      attachDelete(card, anno.file);
    }

    // 悬停出现的「批注」按钮
    const hoverBtn = document.createElement("button");
    hoverBtn.type = "button";
    hoverBtn.className = "anno-float";
    hoverBtn.textContent = "批注";
    hoverBtn.hidden = true;
    document.body.appendChild(hoverBtn);

    let currentBlock: HTMLElement | null = null;
    let formOpen = false;

    blocks.forEach((block) => {
      block.addEventListener("mouseenter", () => {
        if (block.classList.contains("annotation-card") || block.classList.contains("anno-form")) return;
        currentBlock = block;
        const rect = block.getBoundingClientRect();
        // 按钮最高只到文章标题下方，不会飘进标题栏/顶部区域
        const header = document.querySelector(".post-header");
        const minTop = header ? header.getBoundingClientRect().bottom + 4 : 8;
        hoverBtn.style.top = `${Math.max(minTop, Math.min(rect.top - 14, window.innerHeight - 48))}px`;
        hoverBtn.style.left = `${Math.min(rect.right - 10, window.innerWidth - 60)}px`;
        hoverBtn.hidden = false;
      });
    });
    hoverBtn.addEventListener("mouseleave", () => (hoverBtn.hidden = true));
    hoverBtn.addEventListener("mouseenter", () => (hoverBtn.hidden = false));

    const closeForm = () => {
      document.querySelectorAll(".anno-form").forEach((f) => f.remove());
      formOpen = false;
      hoverBtn.hidden = true;
    };

    hoverBtn.addEventListener("click", () => {
      if (formOpen) return closeForm();
      if (!currentBlock) return;
      formOpen = true;
      const token = getUserToken();

      const form = document.createElement("div");
      form.className = "anno-form";
      form.innerHTML = `
        <textarea placeholder="写点批注…支持 {{netdisk 文件名}} 渲染下载卡片"></textarea>
        <div class="anno-form-actions">
          ${token ? '<button type="button" class="anno-netdisk" title="从网盘选文件插入">🌐</button>' : ""}
          ${token ? '<button type="button" class="anno-save">保存批注</button>' : ""}
          <button type="button" class="anno-copy">复制 JSON</button>
          <a class="anno-admin" href="${base}admin/#/collections/annotations/new" target="_blank">去后台</a>
          <button type="button" class="anno-cancel">取消</button>
        </div>
        ${
          token
            ? '<p class="anno-tip">保存后本页立即显示，并自动提交到仓库触发构建（约 1-2 分钟全站可见）。</p>'
            : '<p class="anno-tip">直接保存需要站长身份：先在<a href="' + base + 'admin/" target="_blank">后台</a>用 GitHub 登录一次，再回到本页即可。也可以复制 JSON 到后台粘贴保存。</p>'
        }`;
      currentBlock.insertAdjacentElement("afterend", form);

      form.querySelector(".anno-cancel")!.addEventListener("click", closeForm);

      const ndBtn = form.querySelector<HTMLButtonElement>(".anno-netdisk");
      if (ndBtn) {
        ndBtn.addEventListener("click", () => {
          const ta = form.querySelector<HTMLTextAreaElement>("textarea")!;
          const picker = (window as any).NetdiskPicker;
          if (picker && picker.open) {
            picker.open((basename: string) => {
              const text = `{{netdisk ${basename}}}`;
              const start = ta.selectionStart, end = ta.selectionEnd;
              ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);
              ta.selectionStart = ta.selectionEnd = start + text.length;
              ta.dispatchEvent(new Event("input", { bubbles: true }));
              ta.focus();
            });
          } else {
            // 选择器脚本还没加载：动态加载
            const s = document.createElement("script");
            s.src = base + "netdisk-picker.js";
            s.onload = () => { ndBtn.click(); };
            document.head.appendChild(s);
          }
        });
      }

      form.querySelector<HTMLButtonElement>(".anno-copy")!.addEventListener("click", async (e) => {
        const payload = {
          post: body.getAttribute("data-post") || "",
          index: Number(currentBlock!.dataset.annoIndex),
          quote: (currentBlock!.textContent || "").trim().slice(0, 60),
          content: form.querySelector<HTMLTextAreaElement>("textarea")!.value.trim(),
          date: new Date().toISOString().slice(0, 10),
        };
        try {
          await navigator.clipboard.writeText(JSON.stringify(payload, null, 2));
          e.currentTarget!.textContent = "已复制";
        } catch {
          e.currentTarget!.textContent = "复制失败";
        }
      });

      if (!token) return;

      form.querySelector<HTMLButtonElement>(".anno-save")!.addEventListener("click", async (e) => {
        const btn = e.currentTarget!;
        const text = form.querySelector<HTMLTextAreaElement>("textarea")!.value.trim();
        if (!text) return;
        const anno: Anno = {
          post: body.getAttribute("data-post") || "",
          index: Number(currentBlock!.dataset.annoIndex),
          quote: (currentBlock!.textContent || "").trim().slice(0, 60),
          content: text,
          date: new Date().toISOString().slice(0, 10),
        };
        anno.file = `${new Date().toISOString().replace(/[-:T]/g, "").slice(0, 14)}${Math.random().toString(16).slice(2, 6)}.json`;

        btn.disabled = true;
        btn.textContent = "保存中…";
        try {
          const res = await fetch(`${GH}/repos/${REPO}/contents/src/data/annotations/${anno.file}`, {
            method: "PUT",
            headers: ghHeaders(token),
            body: JSON.stringify({
              message: `批注：${anno.post}`,
              content: b64(JSON.stringify(anno, null, 2) + "\n"),
              branch: BRANCH,
            }),
          });
          if (res.status === 401 || res.status === 403) {
            throw new Error("TOKEN_EXPIRED");
          }
          if (!res.ok) throw new Error(`GitHub API ${res.status}`);
          const card = renderAnnotation(anno);
          if (card) attachDelete(card, anno.file!);
          closeForm();
        } catch (err) {
          btn.disabled = false;
          btn.textContent = "保存批注";
          const tip = form.querySelector<HTMLElement>(".anno-tip")!;
          tip.textContent =
            err instanceof Error && err.message === "TOKEN_EXPIRED"
              ? "登录已过期：请到后台重新登录 GitHub，再回来保存。"
              : `保存失败（${err instanceof Error ? err.message : err}），可复制 JSON 到后台手动保存。`;
        }
      });
    });
  }
</script>
