---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Project } from "../../config";
import projectsData from "../../data/projects.json";

const base = import.meta.env.BASE_URL;
const projects = (projectsData.projects as Project[]).filter((p) => !p.hidden);
// 仓库地址智能补全：owner/仓库名 → 完整 GitHub 链接
const repoUrl = (repo: string) =>
  repo.startsWith("http") ? repo : `https://github.com/${repo.replace(/^\/+|\/+$/g, "")}`;
---

<BaseLayout title="项目" description="我做过的和正在做的项目。">
  <div class="page-head">
    <h1>项目</h1>
    <p>做过的和正在做的项目（在后台「项目展示」中维护）</p>
  </div>

  <div class="grid">
    {
      projects.map((p) => (
        <div class="card">
          <h3>
            {p.url ? (
              <a class="card-link" href={p.url.startsWith("http") ? p.url : base + p.url.replace(/^\//, "")}>
                {p.name}
              </a>
            ) : p.repo ? (
              <a class="card-link" href={repoUrl(p.repo)} target="_blank" rel="noopener">
                {p.name}
              </a>
            ) : (
              p.name
            )}
          </h3>
          <p class="desc">{p.description}</p>
          {p.tags && p.tags.length > 0 && (
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            {p.url && <a href={p.url.startsWith("http") ? p.url : base + p.url.replace(/^\//, "")}>访问 →</a>}
            {p.repo && (
              <a href={repoUrl(p.repo)} target="_blank" rel="noopener">
                源码 →
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
