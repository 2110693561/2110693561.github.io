---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Project } from "../../config";
import projectsData from "../../data/projects.json";

const base = import.meta.env.BASE_URL;
const projects = (projectsData.projects as Project[]).filter((p) => !p.hidden);
---

<BaseLayout title="项目" description="我做过的和正在做的项目。">
  <div class="page-head">
    <h1>项目</h1>
    <p>做过的和正在做的项目（在后台「项目展示」中维护）</p>
  </div>

  <div class="grid">
    {
      projects.map((p) => (
        <div class="card">
          <h3>{p.name}</h3>
          <p class="desc">{p.description}</p>
          {p.tags && p.tags.length > 0 && (
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            {p.url && <a href={p.url.startsWith("http") ? p.url : base + p.url.replace(/^\//, "")}>访问 →</a>}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener">
                源码 →
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
