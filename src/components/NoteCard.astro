---
import type { CollectionEntry } from "astro:content";
import type { EncryptedPayload } from "../utils/encrypt";
import { formatDate } from "../utils/posts";
import LockedContent from "./LockedContent.astro";

interface Props {
  note: CollectionEntry<"notes">;
  /** 未加密时的渲染结果 HTML */
  html?: string;
  /** 有密码时的加密载荷 */
  payload?: EncryptedPayload;
}

const { note, html, payload } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="note-item">
  <div class="card">
    <div class="note-head">
      {note.data.title && <h3>{note.data.title}</h3>}
      <time>{formatDate(note.data.date)}</time>
      {note.data.password && <span class="lock-badge">加密</span>}
      {note.data.tags.map((t) => <span class="tag">{t}</span>)}
      <a
        class="edit-btn"
        href={`${base}admin/#/collections/notes/entries/${note.id}`}
        target="_blank"
        title="在后台编辑这条随手记"
      >
        编辑
      </a>
    </div>
    <div class="note-fold" data-collapsed>
      <div class="note-content">
        {payload ? <LockedContent payload={payload} /> : <Fragment set:html={html} />}
      </div>
      <button class="note-fold-btn" type="button" hidden>展开全文</button>
    </div>
  </div>
</article>

<script>
  // 随手记默认只显示开头，点击「展开全文」查看全部；内容较短则直接完整显示
  document.querySelectorAll(".note-fold").forEach((box) => {
    const content = box.querySelector(".note-content");
    const btn = box.querySelector(".note-fold-btn");
    if (!content || !btn) return;
    if (content.scrollHeight <= 150) {
      box.removeAttribute("data-collapsed");
      return;
    }
    btn.hidden = false;
    btn.addEventListener("click", () => {
      if (box.hasAttribute("data-collapsed")) {
        box.removeAttribute("data-collapsed");
        btn.textContent = "收起";
      } else {
        box.setAttribute("data-collapsed", "");
        btn.textContent = "展开全文";
        box.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });
  });
</script>
