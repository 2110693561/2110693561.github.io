---
import type { Post } from "../utils/posts";
import { formatDate, postUrl, tagUrl } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, category, tags } = post.data;
---

<a class="card" href={postUrl(post.id)}>
  <div class="meta">{formatDate(date)} · {category}</div>
  <h3>{title}</h3>
  {description && <p class="desc">{description}</p>}
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</a>
