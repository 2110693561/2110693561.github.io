---
import "../styles/global.css";
import { SITE, NAV, SOCIALS, ANALYTICS } from "../config";

interface Props {
  /** 页面标题（自动拼接站点名） */
  title?: string;
  /** SEO 描述 */
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · 技术笔记`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = NAV.map((n) => ({
  ...n,
  href: base === "/" ? n.url : base.replace(/\/$/, "") + n.url,
}));
const isActive = (href: string) => (href.replace(/\/$/, "") || "/") === currentPath;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={SITE.favicon.startsWith("http") ? SITE.favicon : `${base}${SITE.favicon.replace(/^\//, "")}`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`${base}rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary" />

    <!-- 主题初始化：渲染前执行，避免明暗切换闪烁 -->
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const theme =
        saved ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={base}>
          {
            SITE.logo &&
              (/^https?:\/\/|^\/.+/i.test(SITE.logo) ? (
                <img class="brand-logo" src={SITE.logo} alt="" />
              ) : (
                <span class="brand-mark">{SITE.logo}</span>
              ))
          }
          {SITE.name}
        </a>
        {
          navItems.map((n) => (
            <a class:list={["navlink", { active: isActive(n.href) }]} href={n.href}>
              {n.text}
            </a>
          ))
        }
        <button id="theme-toggle" class="icon-btn" aria-label="切换明暗主题" title="切换明暗主题">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap inner">
        <div>
          © {new Date().getFullYear()} {SITE.author} · Powered by Astro
          {
            ANALYTICS.busuanzi && (
              <span class="site-stats">
                <span id="busuanzi_container_site_pv" hidden>
                  · 本站总访问量 <span id="busuanzi_value_site_pv" /> 次
                </span>
              </span>
            )
          }
        </div>
        <div class="foot-links">
          {
            SOCIALS.map((s) => (
              <a href={s.url} target={s.url.startsWith("http") ? "_blank" : undefined}>
                {s.name}
              </a>
            ))
          }
        </div>
      </div>
    </footer>

    {
      ANALYTICS.busuanzi && (
        <script is:inline async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" />
      )
    }

    {
      ANALYTICS.busuanzi && (
        <script is:inline>
          // 不蒜子加载成功后才显示统计，避免服务不可用时页脚出现残留文字
          window.addEventListener("load", () => {
            const value = document.getElementById("busuanzi_value_site_pv");
            const container = document.getElementById("busuanzi_container_site_pv");
            if (value && container) {
              const reveal = () => {
                if (value.textContent) container.hidden = false;
              };
              reveal();
              new MutationObserver(reveal).observe(value, { childList: true });
            }
          });
        </script>
      )
    }

    <script>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
